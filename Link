<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kreativer Link-Opener</title>
  <style>
    /* Kreativer, animierter Hintergrund */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
      background-size: 400% 400%;
      animation: gradientBG 15s ease infinite;
      color: #fff;
    }

    @keyframes gradientBG {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* Transparentes, modernes Karten-Design */
    .card {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      padding: 30px 40px;
      border-radius: 20px;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.18);
      text-align: center;
      max-width: 400px;
      width: 90%;
    }

    /* Styling für Titel & Link oben */
    .header-link {
      color: #ffffff;
      text-decoration: none;
      font-size: 1.8rem;
      font-weight: bold;
      text-shadow: 0 2px 4px rgba(0,0,0,0.2);
      transition: color 0.3s ease;
    }

    .header-link:hover {
      color: #ffe600;
    }

    /* Eingabefelder und Labels */
    .input-group {
      margin-top: 25px;
      text-align: left;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
    }

    input[type="url"], input[type="number"] {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 8px;
      box-sizing: border-box;
      font-size: 1rem;
      background: rgba(255, 255, 255, 0.85);
      color: #333;
      outline: none;
    }

    /* Start-Button */
    button {
      margin-top: 25px;
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 8px;
      background-color: #ffe600;
      color: #333;
      font-size: 1.1rem;
      font-weight: bold;
      cursor: pointer;
      transition: transform 0.2s, background-color 0.3s;
    }

    button:hover {
      background-color: #ffd700;
      transform: scale(1.02);
    }
  </style>
</head>
<body>

  <div class="card">
    <a href="https://github.com" target="_blank" class="header-link">Mein GitHub Projekt</a>

    <form id="linkForm">
      <div class="input-group">
        <label for="urlInput">Link:</label>
        <input type="url" id="urlInput" placeholder="https://beispiel.de" required>
      </div>

      <div class="input-group">
        <label for="countInput">Anzahl:</label>
        <input type="number" id="countInput" min="1" max="50" value="1" required>
      </div>

      <button type="button" onclick="openLinks()">Links öffnen</button>
    </form>
  </div>

  <script>
    function openLinks() {
      const url = document.getElementById('urlInput').value;
      const count = parseInt(document.getElementById('countInput').value);

      if (!url) {
        alert("Bitte gib einen gültigen Link ein.");
        return;
      }

      for (let i = 0; i < count; i++) {
        window.open(url, '_blank');
      }
    }
  </script>

</body>
</html>
