<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Soccer Star - Riesige Tribünen & Fix Schuss</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #111; font-family: 'Arial Black', sans-serif; user-select: none; }
        
        /* Menü-Overlays */
        .overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, #114b11 0%, #082408 100%);
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            color: white; z-index: 10;
        }
        h1 { font-size: 45px; text-shadow: 3px 3px 0px #000; margin-bottom: 30px; color: #ffcc00; text-align: center; }
        
        .btn-container { display: flex; flex-direction: column; gap: 15px; width: 280px; }
        
        .setup-box { background: rgba(0,0,0,0.8); padding: 20px; border-radius: 15px; border: 3px solid #ffcc00; width: 300px; display: none; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
        .form-group { margin-bottom: 12px; display: flex; flex-direction: column; }
        label { font-size: 12px; margin-bottom: 5px; color: #ffcc00; }
        input, select { padding: 8px; font-size: 16px; border-radius: 5px; border: none; font-weight: bold; }
        
        .btn {
            background: #4cc64c; color: white; border: none; padding: 15px; font-size: 22px; 
            font-family: 'Arial Black', sans-serif; border-radius: 8px; cursor: pointer; width: 100%;
            box-shadow: 0 5px 0px #2d8a2d; text-shadow: 1px 1px 2px #000; text-align: center;
        }
        .btn:active { transform: translateY(4px); box-shadow: 0 1px 0px #2d8a2d; }
        .btn-blue { background: #1976d2; box-shadow: 0 5px 0px #115293; }
        .btn-blue:active { box-shadow: 0 1px 0px #115293; }

        /* In-Game Benutzeroberfläche */
        #game-ui { position: absolute; top: 20px; width: 100%; text-align: center; color: white; font-size: 28px; text-shadow: 3px 3px 0px #000; pointer-events: none; display: none; }
        #goal-splash {
            position: absolute; top: 35%; width: 100%; text-align: center; color: #ffcc00;
            font-size: 90px; text-shadow: 5px 5px 0px #000; font-weight: 900; display: none;
            animation: pop 0.5s ease-out; pointer-events: none; z-index: 5;
        }
        #home-btn {
            position: absolute; top: 20px; right: 20px; background: #d32f2f; color: white;
            border: 3px solid white; border-radius: 50%; width: 50px; height: 50px; font-size: 24px;
            cursor: pointer; display: none; z-index: 12; line-height: 44px; text-align: center;
        }
        #tutorial-overlay {
            position: absolute; bottom: 12%; width: 100%; text-align: center; color: #fff;
            font-size: 18px; text-shadow: 2px 2px 4px #000; display: none; pointer-events: none;
            z-index: 6; font-weight: bold;
        }

        @keyframes pop {
            0% { transform: scale(0); }
            80% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <div id="menu" class="overlay">
        <h1>MINI SOCCER STAR</h1>
        
        <div class="btn-container" id="menu-buttons">
            <button class="btn" onclick="pressPlay()">PLAY</button>
            <button class="btn btn-blue" onclick="openLockerRoom()">CHARAKTER ÄNDERN</button>
        </div>

        <div class="setup-box" id="locker-ui">
            <div class="form-group">
                <label>TRIKOTFARBE</label>
                <select id="p-color" onchange="updateLockerPlayerVisual()">
                    <option value="0xd32f2f">Rot</option>
                    <option value="0x1976d2">Blau</option>
                    <option value="0xfbc02d">Gelb</option>
                    <option value="0xffffff">Weiß</option>
                    <option value="0x8e24aa">Lila</option>
                </select>
            </div>
            <div class="form-group">
                <label>STARKER FUSS</label>
                <select id="p-foot" onchange="updateLockerPlayerVisual()">
                    <option value="rechts">Rechtsfuß</option>
                    <option value="links">Linksfuß</option>
                </select>
            </div>
            <button class="btn" style="margin-top:10px;" onclick="saveCharacterAndPlay()">SPEICHERN & ZURÜCK</button>
        </div>
    </div>

    <div id="home-btn" onclick="backToMenu()">🏠</div>
    <div id="game-ui">TORE: <span id="score">0</span></div>
    <div id="goal-splash">TOR!!!</div>
    <div id="tutorial-overlay">👉 Auf den Rasen drücken, nach hinten ziehen & loslassen zum Schießen!</div>

<script>
// --- KONFIGURATION & STATE ---
let scene, camera, renderer;
let spieler, torwart, mauerGruppe, ball, zielGruppe, vorschauLine, stadionGruppe;
let kabinenGruppe; 
let ballPhysik = { vx: 0, vy: 0, vz: 0, aktiv: false };
let twPhysik = { vx: 0, vy: 0, aktiv: false };
let istZiehend = false;
let startX = 0, startY = 0;
let schussKraftX = 0, schussKraftY = 0;
let score = 0;
let imSpiel = false;

// Standardwerte falls nichts im Browser gespeichert ist
let savedColor = localStorage.getItem("soccer_star_color") || "0xd32f2f";
let savedFoot = localStorage.getItem("soccer_star_foot") || "rechts";
let playerConfig = { color: parseInt(savedColor), foot: savedFoot };

const vorschauLineMat = new THREE.LineBasicMaterial({ color: 0xffff00, linewidth: 3 });

// --- SPIEL INITIALISIEREN ---
function init() {
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x7ec0ee);

    camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 1000);
    
    renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    document.body.appendChild(renderer.domElement);

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
    scene.add(ambientLight);
    const dirLight = new THREE.DirectionalLight(0xffffff, 0.5);
    dirLight.position.set(10, 30, 10);
    dirLight.castShadow = true;
    scene.add(dirLight);

    // Rasenboden
    const grass = new THREE.Mesh(new THREE.PlaneGeometry(70, 110), new THREE.MeshStandardMaterial({ color: 0x55aa55, roughness: 0.9 }));
    grass.rotation.x = -Math.PI / 2; grass.receiveShadow = true; scene.add(grass);

    // Torlinie
    const linie = new THREE.Mesh(new THREE.PlaneGeometry(24, 0.15), new THREE.MeshBasicMaterial({ color: 0xffffff }));
    linie.rotation.x = -Math.PI / 2; linie.position.set(0, 0.01, -15); scene.add(linie);

    // Torbau
    const torGroup = new THREE.Group();
    const pfostenMat = new THREE.MeshStandardMaterial({ color: 0xffffff });
    const pfostenL = new THREE.Mesh(new THREE.BoxGeometry(0.15, 3.5, 0.15), pfostenMat); pfostenL.position.set(-5, 1.75, -15);
    const pfostenR = new THREE.Mesh(new THREE.BoxGeometry(0.15, 3.5, 0.15), pfostenMat); pfostenR.position.set(5, 1.75, -15);
    const latte = new THREE.Mesh(new THREE.BoxGeometry(10.15, 0.15, 0.15), pfostenMat); latte.position.set(0, 3.5, -15);
    torGroup.add(pfostenL, pfostenR, latte); scene.add(torGroup);

    // Stadion & Kabine bauen
    stadionGruppe = new THREE.Group();
    scene.add(stadionGruppe);
    buildLockerRoomScene();
    rebuildStadium(); // Baut Tribünen mit den richtigen Fanfarben

    // Ball & Visueller Zielring
    ball = new THREE.Mesh(new THREE.SphereGeometry(0.25, 16, 16), new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.4 }));
    ball.castShadow = true; scene.add(ball);

    zielGruppe = new THREE.Group();
    const ring = new THREE.Mesh(new THREE.RingGeometry(0.45, 0.5, 32), new THREE.MeshBasicMaterial({ color: 0xffff00, side: THREE.DoubleSide }));
    ring.rotation.x = -Math.PI / 2;
    const stern = new THREE.Mesh(new THREE.ConeGeometry(0.15, 0.4, 4), new THREE.MeshBasicMaterial({ color: 0xffff00 }));
    stern.position.y = 0.25; stern.rotation.x = Math.PI;
    zielGruppe.add(ring, stern); scene.add(zielGruppe);

    // Event-Listener für Mauseingaben/Touches auf dem ganzen Fenster
    window.addEventListener('mousedown', onMouseDown);
    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup', onMouseUp);

    // Zeige direkt die Kabinenszene im Hintergrund des Hauptmenüs
    showLockerRoomSceneVisuals(true);
    updateLockerPlayerVisual();
}

// --- CHARAKTER GENERATOR ---
function createCharacterMesh(jerseyColor, shortsColor) {
    const group = new THREE.Group();
    const skinMat = new THREE.MeshStandardMaterial({ color: 0xffdbac });
    const jMat = new THREE.MeshStandardMaterial({ color: jerseyColor });
    const sMat = new THREE.MeshStandardMaterial({ color: shortsColor });
    const hairMat = new THREE.MeshStandardMaterial({ color: 0x331a00 });

    const torso = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.8, 0.35), jMat); torso.position.y = 1.1; torso.castShadow = true; group.add(torso);
    const head = new THREE.Mesh(new THREE.BoxGeometry(0.46, 0.46, 0.46), skinMat); head.position.y = 1.72; head.castShadow = true; group.add(head);
    const hair = new THREE.Mesh(new THREE.BoxGeometry(0.48, 0.15, 0.48), hairMat); hair.position.y = 1.98; group.add(hair);

    const legL = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.7, 0.2), sMat); legL.position.set(-0.18, 0.35, 0); legL.castShadow = true;
    const legR = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.7, 0.2), sMat); legR.position.set(0.18, 0.35, 0); legR.castShadow = true;
    group.add(legL, legR);

    const armL = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.6, 0.16), jMat); armL.position.set(-0.4, 1.1, 0); armL.castShadow = true;
    const armR = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.6, 0.16), jMat); armR.position.set(0.4, 1.1, 0); armR.castShadow = true;
    group.add(armL, armR);

    group.userData = { legL, legR, armL, armR };
    return group;
}

// --- GROSSE TRIBÜNEN & STADIONBAU ---
function rebuildStadium() {
    // Vorheriges Stadion leeren
    while(stadionGruppe.children.length > 0){
        stadionGruppe.remove(stadionGruppe.children[0]);
    }

    // Farben: Deine ausgewählte Trikotfarbe gemischt mit Gelb/Schwarz der Gegner
    const fanColors = [playerConfig.color, playerConfig.color, 0xfbc02d, 0x212121, 0xffffff];

    function makeHugeStand(w, stepsCount, d, px, py, pz, ry) {
        const g = new THREE.Group();
        
        // Stufenbau für gigantische Wirkung (stepsCount auf 6 erhöht für XXL-Tribüne)
        for (let r = 0; r < stepsCount; r++) {
            const stepGeo = new THREE.BoxGeometry(w, 1.2, d);
            const stepMat = new THREE.MeshStandardMaterial({ color: 0x444444, roughness: 0.9 });
            const step = new THREE.Mesh(stepGeo, stepMat);
            step.position.set(0, r * 0.9, -r * d);
            g.add(step);
            
            // Viele dicht besetzte Fans platzieren
            for (let f = -w/2 + 0.8; f < w/2; f += 1.1) {
                const fanGeo = new THREE.BoxGeometry(0.45, 0.6, 0.45);
                const fanMat = new THREE.MeshStandardMaterial({ color: fanColors[Math.floor(Math.random() * fanColors.length)] });
                const fan = new THREE.Mesh(fanGeo, fanMat);
                fan.position.set(f, (r * 0.9) + 0.9, -r * d);
                g.add(fan);
            }
        }
        
        // Große gelbe Bande vor der Tribüne
        const bande = new THREE.Mesh(new THREE.BoxGeometry(w, 2.2, 0.2), new THREE.MeshStandardMaterial({ color: 0xfbc02d }));
        bande.position.set(0, 0.6, 1.2);
        g.add(bande);

        g.position.set(px, py, pz);
        g.rotation.y = ry;
        stadionGruppe.add(g);
    }

    // Die 3 riesigen Tribünen erzeugen (6 Etagen hoch!)
    makeHugeStand(50, 6, 1.6, 0, 0.6, -25, 0); // Hintertor-Tribüne
    makeHugeStand(65, 6, 1.6, -26, 0.6, -5, Math.PI / 2); // Linke Tribüne
    makeHugeStand(65, 6, 1.6, 26, 0.6, -5, -Math.PI / 2); // Rechte Tribüne
}

function buildLockerRoomScene() {
    kabinenGruppe = new THREE.Group();
    const floor = new THREE.Mesh(new THREE.PlaneGeometry(15, 15), new THREE.MeshStandardMaterial({ color: 0x8b5a2b, roughness: 0.7 }));
    floor.rotation.x = -Math.PI / 2; floor.position.y = 20;
    kabinenGruppe.add(floor);

    const wall = new THREE.Mesh(new THREE.PlaneGeometry(15, 6), new THREE.MeshStandardMaterial({ color: 0x333333 }));
    wall.position.set(0, 23, -4); kabinenGruppe.add(wall);

    for (let i = -4; i <= 4; i += 1.5) {
        const locker = new THREE.Mesh(new THREE.BoxGeometry(1.2, 4.5, 1), new THREE.MeshStandardMaterial({ color: 0x506070 }));
        locker.position.set(i, 22.25, -3.4); kabinenGruppe.add(locker);
    }
    scene.add(kabinenGruppe);
}

function showLockerRoomSceneVisuals(show) {
    kabinenGruppe.position.y = show ? 0 : -50;
    if(show) {
        camera.position.set(0, 22, 6);
        camera.lookAt(0, 21.5, 0);
    }
}

// --- MENÜ INTERAKTIONEN ---
function pressPlay() {
    document.getElementById("menu").style.display = "none";
    document.getElementById("game-ui").style.display = "block";
    document.getElementById("home-btn").style.display = "block";
    document.getElementById("tutorial-overlay").style.display = "block"; // Zeigt Schuss-Anleitung
    
    showLockerRoomSceneVisuals(false);
    imSpiel = true;

    // Erneuere Stadionfans basierend auf aktueller Trikotfarbe
    rebuildStadium();

    if (!torwart) {
        torwart = createCharacterMesh(0x111111, 0x111111);
        scene.add(torwart);
    }

    if (spieler) scene.remove(spieler);
    spieler = createCharacterMesh(playerConfig.color, 0x222222);
    scene.add(spieler);

    randomizeMatchLayout();
}

function openLockerRoom() {
    document.getElementById("menu-buttons").style.display = "none";
    document.getElementById("locker-ui").style.display = "block";
}

function updateLockerPlayerVisual() {
    if (spieler) scene.remove(spieler);
    const col = parseInt(document.getElementById("p-color").value);
    spieler = createCharacterMesh(col, 0x111111);
    spieler.position.set(0, 20, 0);
    spieler.rotation.y = 0.2;
    scene.add(spieler);
}

function saveCharacterAndPlay() {
    const colStr = document.getElementById("p-color").value;
    const footStr = document.getElementById("p-foot").value;
    localStorage.setItem("soccer_star_color", colStr);
    localStorage.setItem("soccer_star_foot", footStr);
    
    playerConfig.color = parseInt(colStr);
    playerConfig.foot = footStr;

    document.getElementById("locker-ui").style.display = "none";
    document.getElementById("menu-buttons").style.display = "flex";
    updateLockerPlayerVisual();
}

// --- ANZUG- UND SCHUSSPOSITIONEN ---
function randomizeMatchLayout() {
    const bX = (Math.random() - 0.5) * 6;
    const bZ = 1 + Math.random() * 3.5;
    ball.position.set(bX, 0.25, bZ);

    // Versetzte Aufstellung je nach gewähltem starken Fuß
    const versatzX = playerConfig.foot === "rechts" ? -0.55 : 0.55;
    spieler.position.set(bX + versatzX, 0, bZ + 1.4);
    spieler.rotation.set(0, 0, 0);
    spieler.userData.legL.rotation.x = 0; spieler.userData.legR.rotation.x = 0;

    camera.position.set(bX, 4.4, bZ + 5.8);
    camera.lookAt(bX, 1.3, -10);

    zielGruppe.position.set(bX, 0.05, bZ);
    zielGruppe.visible = true;

    // Defensivmauer formieren
    if (mauerGruppe) scene.remove(mauerGruppe);
    mauerGruppe = new THREE.Group();
    const count = 3 + Math.floor(Math.random() * 3);
    const startMauerX = bX * 0.5 - (count * 0.35) / 2;
    const mauerZ = -4 - Math.random() * 1.5;

    for (let i = 0; i < count; i++) {
        const def = createCharacterMesh(i % 2 === 0 ? 0xfbc02d : 0x212121, 0x212121);
        def.position.set(startMauerX + (i * 0.7), 0, mauerZ);
        mauerGruppe.add(def);
    }
    scene.add(mauerGruppe);

    torwart.position.set(0, 0, -14.5);
    torwart.rotation.set(0, 0, 0);
    torwart.userData.armL.rotation.set(0,0,0); torwart.userData.armR.rotation.set(0,0,0);
    twPhysik = { vx: 0, vy: 0, aktiv: false };
    ballPhysik = { vx: 0, vy: 0, vz: 0, aktiv: false };
}

// --- ABSOLUT FUNKTIONIERENDE SCHUSSTEUERUNG ---
function onMouseDown(e) {
    if (!imSpiel || ballPhysik.aktiv) return;
    istZiehend = true;
    startX = e.clientX;
    startY = e.clientY;
}

function onMouseMove(e) {
    if (!istZiehend) return;
    
    // Berechne die reinen Pixelabstände der Mausbewegung
    const deltaX = startX - e.clientX;
    const deltaY = startY - e.clientY;

    // Perfekt skalierte Kraft-Multiplikatoren
    schussKraftX = deltaX * 0.03;
    schussKraftY = deltaY * 0.045; 

    // Gelbe Vorschau-Fluglinie zeichnen
    if (vorschauLine) scene.remove(vorschauLine);
    const punkte = [
        ball.position.clone(),
        ball.position.clone().add(new THREE.Vector3(schussKraftX, Math.abs(schussKraftY) * 0.22, -schussKraftY))
    ];
    const geo = new THREE.BufferGeometry().setFromPoints(punkte);
    vorschauLine = new THREE.Line(geo, vorschauLineMat);
    scene.add(vorschauLine);
    
    zielGruppe.children[1].rotation.y += 0.2;
}

function onMouseUp() {
    if (!istZiehend) return;
    istZiehend = false;
    
    if (vorschauLine) { scene.remove(vorschauLine); vorschauLine = null; }
    document.getElementById("tutorial-overlay").style.display = "none"; // Blendet Anleitung aus

    // Tritt-Bein-Animation ausführen
    if (playerConfig.foot === "rechts") {
        spieler.userData.legR.rotation.x = -0.75;
    } else {
        spieler.userData.legL.rotation.x = -0.75;
    }

    // Physikalische Bewegung auf den Ball übertragen
    ballPhysik.vx = schussKraftX;
    ballPhysik.vy = Math.max(1.4, Math.abs(schussKraftY) * 0.26); 
    ballPhysik.vz = -schussKraftY; 
    ballPhysik.aktiv = true;
    
    zielGruppe.visible = false;

    // Torwart Berechnungen für den Abhechtsprung
    const tToTor = (-14.5 - ball.position.z) / ballPhysik.vz;
    const targetX = ball.position.x + (ballPhysik.vx * tToTor);

    if (ballPhysik.vz < -2) {
        twPhysik.aktiv = true;
        twPhysik.vx = (targetX - torwart.position.x) * 0.085;
        twPhysik.vy = 0.22;
        torwart.userData.armL.rotation.z = 1.3; torwart.userData.armR.rotation.z = -1.3;
    }
}

// --- ENGINE RECHENTICK ---
function animate() {
    requestAnimationFrame(animate);

    if (twPhysik.aktiv) {
        torwart.position.x += twPhysik.vx;
        torwart.position.y += twPhysik.vy;
        twPhysik.vy -= 0.013;
        if (twPhysik.vx > 0.01) torwart.rotation.z = -0.6;
        if (twPhysik.vx < -0.01) torwart.rotation.z = 0.6;
        if (torwart.position.y < 0) { torwart.position.y = 0; twPhysik.aktiv = false; }
    }

    if (ballPhysik.aktiv) {
        ball.position.x += ballPhysik.vx;
        ball.position.y += ballPhysik.vy;
        ball.position.z += ballPhysik.vz;
        ballPhysik.vy -= 0.08; 

        if (ball.position.y < 0.25) { ball.position.y = 0.25; ballPhysik.vy *= -0.22; }

        mauerGruppe.children.forEach(d => {
            if (ball.position.distanceTo(d.position) < 0.8 && ball.position.y < 2) {
                ballPhysik.vz *= -0.3; ballPhysik.vx += (Math.random() - 0.5) * 1.5;
            }
        });

        if (ball.position.distanceTo(torwart.position) < 1.1) {
            ballPhysik.aktiv = false; setTimeout(randomizeMatchLayout, 1000);
        }

        // TERTREFFER CHECK
        if (ball.position.z <= -15 && ball.position.z > -16) {
            if (ball.position.x >= -5 && ball.position.x <= 5 && ball.position.y <= 3.5) {
                ballPhysik.aktiv = false;
                goalScored();
            }
        }

        if (ball.position.z < -18 || Math.abs(ball.position.x) > 22) {
            ballPhysik.aktiv = false; setTimeout(randomizeMatchLayout, 1000);
        }
    }

    if (renderer) renderer.render(scene, camera);
}

function goalScored() {
    score++;
    document.getElementById("score").innerText = score;
    const splash = document.getElementById("goal-splash");
    splash.style.display = "block";
    setTimeout(() => { splash.style.display = "none"; randomizeMatchLayout(); }, 1400);
}

function backToMenu() {
    imSpiel = false;
    document.getElementById("menu").style.display = "flex";
    document.getElementById("menu-buttons").style.display = "flex";
    document.getElementById("locker-ui").style.display = "none";
    document.getElementById("game-ui").style.display = "none";
    document.getElementById("home-btn").style.display = "none";
    document.getElementById("tutorial-overlay").style.display = "none";
    showLockerRoomSceneVisuals(true);
    updateLockerPlayerVisual();
}

// Spiel starten
init();
animate();
</script>
</body>
</html>
